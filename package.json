{
  "name": "veilbound-next-repo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean production codebase for Veilbound. No rejected prototype renderer or placeholder art.",
  "scripts": {
    "dev": "node tools/serve-slice.mjs",
    "assets:materialize": "python tools/materialize-gold-standard-assets.py",
    "prestart": "npm run assets:materialize",
    "start": "node tools/serve-slice.mjs",
    "precheck:slice": "npm run assets:materialize",
    "check:slice": "node tools/check-playable-slice.mjs",
    "materialize:canon": "python tools/materialize-canon.py",
    "materialize:references": "python tools/materialize-references.py",
    "pretest": "python tools/materialize-canon.py && npm run assets:materialize",
    "test": "node --test tests/*.test.js",
    "preverify": "python tools/materialize-canon.py && npm run assets:materialize",
    "verify": "node tools/verify-production-boundary.mjs && node --test tests/*.test.js",
    "sim": "python simulation/run_closed_suite.py"
  },
  "engines": {
    "node": ">=22"
  }
}
