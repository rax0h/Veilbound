{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veilbound Visual Asset Manifest",
  "type": "object",
  "required": ["id","asset_class","status","placeholder","reference_lineage"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "asset_class": {"enum":["environment","exploration_body","battle_body","ui_dialogue_portrait","creature","ui","vfx","prop","equipment"]},
    "status": {"enum":["concept","candidate","production_ready"]},
    "placeholder": {"type":"boolean"},
    "reference_lineage": {"type":"array","minItems":1,"items":{"type":"string"}},
    "camera": {"type":"object"},
    "character_family": {"type":"string"}
  }
}
